# FLAVENCIA 2026 - Central Backend Environment Variables
# Configure this in your Vercel Project Settings > Environment Variables or in .env.local

# Central Google Apps Script Web App Deployment URL (ends in /exec)
# Note: The Google Spreadsheet ID is configured centrally inside the Google Apps Script backend
# (via container binding or Script Properties). Clients and admins do not need to configure it.
VITE_GAS_URL=https://script.google.com/macros/s/AKfycb.../exec
